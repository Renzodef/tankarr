{
  "name": "tankarr-frontend",
  "private": true,
  "version": "0.12.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "benchmark": "node e2e/benchmark.mjs",
    "screenshots": "node e2e/screenshots.mjs",
    "demo:record": "node e2e/demo-record.mjs",
    "demo:build": "node scripts/build-demo.mjs",
    "demo:test": "playwright test --config playwright.demo.config.ts",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
