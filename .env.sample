TANKARR_HOST=0.0.0.0
TANKARR_PORT=8787
# Sub-path Tankarr is served under behind a reverse proxy, for example /tankarr.
# Empty serves everything from the root of its host name.
TANKARR_URL_BASE=
# debug, info, warning or error: the console and logs/tankarr.log share it.
TANKARR_LOG_LEVEL=info
# Host address docker-compose.yml publishes the web interface on: 127.0.0.1
# for this machine only, 0.0.0.0 to reach it from your network.
TANKARR_BIND_ADDRESS=127.0.0.1
# Image tag docker-compose.yml pulls: latest (the newest release), X.Y to stay
# on one release line, or branch-<name> to try a branch under test.
TANKARR_IMAGE_TAG=latest
# Time zone of the container: log timestamps, the Calendar and the nightly
# maintenance window (03:00 to 06:00) follow it.
TZ=Etc/UTC
TANKARR_HOST_CONFIG_DIR=./data
TANKARR_HOST_LIBRARY_DIR=/path/to/your/comics
TANKARR_HOST_IMPORT_DIR=./data/import
TANKARR_DATA_DIR=/config
TANKARR_LIBRARY_DIR=/library
TANKARR_IMPORT_DIR=/import
TANKARR_FRONTEND_DIR=/app/frontend/dist
TANKARR_DEFAULT_LANGUAGE=en
TANKARR_SEARCH_LANGUAGES=en
TANKARR_MONITOR_ENABLED=true
TANKARR_MONITOR_INTERVAL_SECONDS=900
# Periodically retries monitored backlog entries that remain in Wanted.
TANKARR_WANTED_SEARCH_ENABLED=true
TANKARR_WANTED_SEARCH_INTERVAL_SECONDS=21600
# Series looked at per Wanted pass, most overdue first; the rest wait for the
# next pass.
TANKARR_WANTED_SEARCH_BUDGET=25
# Keep the library on the numbering of the official edition in your language:
# chapters past what the publisher released belong to a different edition and
# are removed. Set to false to report them without deleting anything.
TANKARR_OFFICIAL_EDITION_ALIGNMENT_ENABLED=true
# Measure imported chapters against the work's own page geometry and replace
# the unreadable ones when another source has them.
TANKARR_PAGE_QUALITY_RECOVERY_ENABLED=true
# Maximum simultaneous chapter jobs. 0 lets Tankarr derive it from live CPU,
# memory, network/source latency, rate limiting and platform thermal limits.
TANKARR_DOWNLOAD_PIPELINE_MAX=0
TANKARR_METADATA_ENABLED=true
TANKARR_METADATA_REFRESH_INTERVAL_HOURS=168
# Refresh persisted MangaBaka author work lists once per day.
TANKARR_AUTHOR_REFRESH_INTERVAL_HOURS=24
TANKARR_SUWAYOMI_ENABLED=false
# managed: Tankarr downloads the official Suwayomi-Server and runs it inside
# its own container. external: Tankarr connects to a Suwayomi server you run
# yourself, at TANKARR_SUWAYOMI_URL with the optional username and password.
TANKARR_SUWAYOMI_MODE=managed
# Index URL of the Mihon/Tachiyomi-compatible extension repository the managed
# server installs sources from. Tankarr ships none: enter one you trust.
TANKARR_SUWAYOMI_EXTENSION_STORE=
TANKARR_SUWAYOMI_URL=http://suwayomi:4567
TANKARR_SUWAYOMI_USERNAME=
TANKARR_SUWAYOMI_PASSWORD=
TANKARR_SUWAYOMI_LANGUAGE=en
# Optional comma-separated stable source IDs. Empty means every installed safe source.
TANKARR_SUWAYOMI_SOURCE_IDS=
TANKARR_SUWAYOMI_SEARCH_TIMEOUT_SECONDS=30
# archive.org as a direct-download book source: whole volumes (CBZ, CBR, PDF)
# fetched by Tankarr itself, no torrent client involved. Asked by title, once per
# pass, never chapter by chapter; ranked below every indexer.
TANKARR_INTERNET_ARCHIVE_ENABLED=true
# Optional Prowlarr indexer manager: torrent and NZB releases found through it
# are handed to the qBittorrent or SABnzbd client below. These values can also
# be set in Settings > Indexers & torrents.
TANKARR_PROWLARR_ENABLED=false
TANKARR_PROWLARR_URL=http://prowlarr:9696
TANKARR_PROWLARR_API_KEY=
# Optional comma-separated indexer IDs. Empty means every indexer Prowlarr syncs.
TANKARR_PROWLARR_INDEXER_IDS=
# Newznab/Torznab categories searched: 7000 Books, 7020 Comics, 7030 Magazines.
TANKARR_PROWLARR_CATEGORIES=7000,7020,7030
# Optional qBittorrent client for torrent releases found through Prowlarr.
# These values can also be set in Settings > Indexers & torrents.
TANKARR_QBITTORRENT_URL=http://qbittorrent:8080
# The address a browser can open; qbittorrent_url above is often a Docker
# service name a browser cannot resolve. Powers the shortcut in Activity.
TANKARR_QBITTORRENT_PUBLIC_URL=
TANKARR_QBITTORRENT_USERNAME=
TANKARR_QBITTORRENT_PASSWORD=
TANKARR_QBITTORRENT_CATEGORY=tankarr
TANKARR_QBITTORRENT_SAVE_PATH=/data/downloads/tankarr
TANKARR_HOST_TORRENT_DIR=./data/downloads/tankarr
TANKARR_TORRENT_DOWNLOAD_DIR=/downloads
TANKARR_TORRENT_AUTO_IMPORT=true
# Optional SABnzbd client for Usenet (NZB) releases found through Prowlarr.
# These values can also be set in Settings > Indexers & torrents.
TANKARR_SABNZBD_URL=http://sabnzbd:8080
# The address a browser can open, like TANKARR_QBITTORRENT_PUBLIC_URL.
TANKARR_SABNZBD_PUBLIC_URL=
TANKARR_SABNZBD_API_KEY=
TANKARR_SABNZBD_CATEGORY=tankarr
# SABnzbd's completed folder as SABnzbd itself sees it. Mount the same folder
# read-only into Tankarr: TANKARR_HOST_USENET_DIR on the host,
# TANKARR_USENET_DOWNLOAD_DIR inside the container.
TANKARR_SABNZBD_COMPLETE_PATH=/data/downloads/usenet
TANKARR_HOST_USENET_DIR=./data/downloads/usenet
TANKARR_USENET_DOWNLOAD_DIR=/usenet
# Forms gives an Arr-style login page; Basic uses the browser credential prompt.
TANKARR_AUTH_METHOD=forms
# Leave both empty and Tankarr creates a login on its first start and prints
# it to the log; change it later under Settings > Security.
TANKARR_AUTH_USERNAME=
TANKARR_AUTH_PASSWORD=
# false lets your own network (private and loopback addresses) in without a
# login; behind a reverse proxy set the trusted proxies first.
TANKARR_AUTH_REQUIRED_FOR_LOCAL=true
# Reverse proxies whose forwarded client address is believed (comma-separated
# addresses or networks); required by TANKARR_AUTH_METHOD=external.
TANKARR_AUTH_TRUSTED_PROXIES=
# Reader that series and book links open: tankarr (built-in), komga, kavita,
# stump, url or none. auto picks Komga when its link is enabled, otherwise the
# built-in reader.
TANKARR_READER_KIND=auto
# Default mode of the built-in reader: manga (pages), webtoon (vertical strip)
# or auto (chosen per series from its metadata).
TANKARR_READER_DISPLAY_MODE=auto
# Optional managed Komga mirror. Tankarr scans the selected library and applies
# its canonical metadata/covers; Komga reading progress remains untouched.
TANKARR_KOMGA_LINK_ENABLED=false
TANKARR_KOMGA_URL=http://komga:25600
# Infrastructure-only Docker route; not shown in the Tankarr frontend.
TANKARR_KOMGA_INTERNAL_URL=
TANKARR_KOMGA_LIBRARY_ID=
# auto uses the API key when set, otherwise the username/password pair;
# api_key and basic force one of the two.
TANKARR_KOMGA_AUTH_METHOD=auto
TANKARR_KOMGA_REFRESH_INTERVAL_MINUTES=360
TANKARR_KOMGA_API_KEY=
TANKARR_KOMGA_USERNAME=
TANKARR_KOMGA_PASSWORD=
TANKARR_NTFY_URL=
TANKARR_NTFY_TOPIC=tankarr
TANKARR_NTFY_ON_CHAPTER_IMPORTED=true
TANKARR_NTFY_ON_DOWNLOAD_FAILED=true
TANKARR_NTFY_ON_DECISION_NEEDED=true
# More channels; the three event switches above apply to every channel.
# Generic webhook: one JSON document per event, optional bearer token.
TANKARR_WEBHOOK_URL=
TANKARR_WEBHOOK_TOKEN=
# Discord channel webhook (Channel settings > Integrations > Webhooks).
TANKARR_DISCORD_WEBHOOK_URL=
# Telegram bot (token from @BotFather) and the chat it posts to.
TANKARR_TELEGRAM_BOT_TOKEN=
TANKARR_TELEGRAM_CHAT_ID=
# Apprise API server, with a stored configuration key or notification URLs.
TANKARR_APPRISE_URL=
TANKARR_APPRISE_KEY=
TANKARR_APPRISE_URLS=
# Optional: where backup bundles are written; the default is <data dir>/backups.
# A second disk keeps them safe when the data disk fails. With Docker Compose,
# uncomment the two backup lines in docker-compose.yml instead.
# TANKARR_BACKUP_DIRECTORY=/path/to/another/disk/tankarr-backups

# Optional translation fallback; also opt in separately for each series.
# The processor owns OCR/rendering. See docs/translation.md.
TANKARR_TRANSLATION_ENABLED=false
TANKARR_TRANSLATION_SOURCE_LANGUAGES=original
TANKARR_TRANSLATION_PROCESSOR_URL=
TANKARR_TRANSLATION_PROCESSOR_TOKEN=
TANKARR_TRANSLATION_AI_URL=
TANKARR_TRANSLATION_AI_MODEL=
TANKARR_TRANSLATION_AI_API_KEY=
